# Copy to backend/.env and adjust. All values are optional; defaults are shown.

# ABSA_LOG_LEVEL=INFO

# SQLite file by default; any SQLAlchemy URL works (e.g. PostgreSQL later).
# ABSA_DATABASE_URL=sqlite:///../data/absa.db

# Where the trained models live.
# ABSA_ASPECT_MODEL_DIR=../models/aspect_extraction
# ABSA_SENTIMENT_MODEL_DIR=../models/sentiment
# ABSA_OVERALL_MODEL_DIR=../models/overall_sentiment
# ABSA_MAX_LENGTH=128

# false = start the API without models (/api/analyze then answers 503).
# ABSA_LOAD_MODELS=true

# Frontend origins allowed by CORS, comma-separated.
# ABSA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
